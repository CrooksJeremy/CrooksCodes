# Supabase — project URL and keys from Supabase dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth token for protected project routes (POST/PUT/DELETE /api/projects).
# Generate a random 32-byte hex string:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Resend — contact form email notifications (https://resend.com)
# Use "Sending access" scope when creating the key.
RESEND_API_KEY=
CONTACT_EMAIL_TO=you@example.com
CONTACT_EMAIL_FROM=Your Name <onboarding@resend.dev>

# CORS whitelist for production — comma-separated origins.
# Leave unset in local dev (middleware falls back to open CORS).
# Example:  CORS_ORIGIN=https://yourdomain.ca,https://www.yourdomain.ca
# CORS_ORIGIN=

# Optional: server port (defaults to 5000)
# PORT=5000
