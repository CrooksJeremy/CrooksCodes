# Public site URL — used for OG/Twitter canonical metadata.
# Local dev:        http://localhost:3000
# Production:       https://crookscodes.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form (server-only — used by app/api/contact) ─────────────────────
# Supabase project URL and SERVICE-ROLE key. The service-role key bypasses
# RLS, so it must never be exposed to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — contact-form email notifications.
RESEND_API_KEY=your-resend-api-key
CONTACT_EMAIL_TO=you@example.com
CONTACT_EMAIL_FROM=CrooksCodes <onboarding@resend.dev>
